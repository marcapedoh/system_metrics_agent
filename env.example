
# --- Agent ---
# Exécution hors Docker : http://127.0.0.1:8000/metrics
# Avec Docker Compose, cette valeur est forcée à http://api:8000/metrics
# dans docker-compose.yml (nom du service sur le réseau Docker).
METRICS_ENDPOINT=http://127.0.0.1:8000/metrics

# Intervalle entre deux collectes, en secondes
COLLECTION_INTERVAL=5

# Timeout HTTP en secondes
REQUEST_TIMEOUT=5

# --- Docker Compose ---
# Port publié sur la machine hôte pour l'API
API_PORT=8000
